{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeanType Sound Pack",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "versionCode",
    "versionName",
    "sounds"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "versionCode": {
      "type": "integer",
      "minimum": 1
    },
    "versionName": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "minAppVersionCode": {
      "type": "integer",
      "minimum": 1
    },
    "defaultMasterVolume": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "preview": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sounds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "files"
        ],
        "properties": {
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "single",
              "random",
              "cycle"
            ]
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
